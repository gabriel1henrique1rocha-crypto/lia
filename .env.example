NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...>
# Domínio canônico (og:url/canonical via metadataBase — ver D-08 em .specs/project/DECISIONS.md)
# Valor real de Production é setado na Vercel, não aqui.
NEXT_PUBLIC_SITE_URL=https://www.observatorioolda.com.br
# Apenas server-side — não adicionar prefixo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Habilita a rota /styleguide (auditoria a11y). Omitir em produção para retornar 404.
# ENABLE_STYLEGUIDE=true
